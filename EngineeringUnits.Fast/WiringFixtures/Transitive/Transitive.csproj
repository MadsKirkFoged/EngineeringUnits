<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Set by AnalyzerWiringTests as an environment variable, so it doesn't leak into the referenced projects as a global property -->
    <DefineConstants Condition="'$(FAST_FIXTURE_MISTAKE)' == 'true'">$(DefineConstants);MISTAKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- No direct reference to EngineeringUnits.Fast: it comes through Library -->
    <ProjectReference Include="..\Library\Library.csproj" />
  </ItemGroup>
</Project>
