<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <Title>EngineeringUnits</Title>
    <PackageId>EngineeringUnits</PackageId>
    <Authors>Mads Kirk Foged</Authors>
    <Description>An Engineering version of UnitsNet - Do calculations and converts between any type of unit</Description>
    <PackageProjectUrl>https://github.com/MadsKirkFoged/EngineeringUnits</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MadsKirkFoged/EngineeringUnits</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>UnitsNet Unit units measurement si metric imperial convert conversion Physics Engineering science Math mathematics calculation</PackageTags>
    <IsPackable>true</IsPackable>
	<LangVersion>preview</LangVersion>
	<Nullable>enable</Nullable>
	<IncludeSymbols>True</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fractions" Version="8.3.2" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Nullable" Version="1.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Uno.Core.Extensions.Collections" Version="4.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runs the analyzer on this project and makes sure it is built before packing -->
    <ProjectReference Include="..\EngineeringUnits.Analyzers\EngineeringUnits.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship the analyzer inside the EngineeringUnits package so consumers get it automatically -->
  <Target Name="IncludeAnalyzerInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\EngineeringUnits.Analyzers\EngineeringUnits.Analyzers.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_EngineeringUnitsAnalyzer" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_EngineeringUnitsAnalyzer)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
